# Local mock service
VENDOR_RISK_BASE_URL=http://127.0.0.1:8001

# Gemini (Google AI Studio key). Never commit .env.
GOOGLE_API_KEY=
MODEL_NAME=gemini-3.7-flash

# live = call the API and record responses; replay = use recorded responses only (no key needed); off = deterministic checks only
LLM_MODE=live
# Optional: minimum seconds between LLM calls (free-tier rate limits)
LLM_MIN_INTERVAL_S=0

# Local model alternative (LM Studio / Ollama / vLLM, OpenAI-compatible API):
# LLM_PROVIDER=openai
# LLM_BASE_URL=http://localhost:1234/v1
# MODEL_NAME=<model id from http://localhost:1234/v1/models>
# LLM_TIMEOUT_S=300
